# Local development uses demo emulators by default. No production credentials needed.
VITE_USE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# For a real Firebase project, set false and supply all six public web config values.
# Never place a service-account key or other privileged credential in a VITE_ variable.
# VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
