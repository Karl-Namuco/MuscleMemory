rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function approved(uid) {
      return owner(uid) && get(/databases/$(database)/documents/approvedUsers/$(uid)).data.active == true;
    }
    function stringWithin(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function uniqueOptions(value, options) {
      // Uniqueness and the finite allowlist already bound the list length.
      return value is list && value.hasOnly(options) && value.toSet().size() == value.size();
    }
    function muscles(value) {
      return uniqueOptions(value, ['Chest', 'Shoulders', 'Back', 'Biceps', 'Triceps', 'Quadriceps', 'Hamstrings', 'Glutes', 'Calves', 'Core']);
    }
    function exerciseNames(values) {
      let count = values.size();
      // Keep each index inline: repeated helper arguments exceed the expression
      // budget when both exercise lists contain the maximum allowed 10 names.
      return values is list && count <= 10 && values.toSet().size() == count
        && (count <= 0 || (values[0] is string && values[0].matches('^[\\s\\S]{1,120}$')))
        && (count <= 1 || (values[1] is string && values[1].matches('^[\\s\\S]{1,120}$')))
        && (count <= 2 || (values[2] is string && values[2].matches('^[\\s\\S]{1,120}$')))
        && (count <= 3 || (values[3] is string && values[3].matches('^[\\s\\S]{1,120}$')))
        && (count <= 4 || (values[4] is string && values[4].matches('^[\\s\\S]{1,120}$')))
        && (count <= 5 || (values[5] is string && values[5].matches('^[\\s\\S]{1,120}$')))
        && (count <= 6 || (values[6] is string && values[6].matches('^[\\s\\S]{1,120}$')))
        && (count <= 7 || (values[7] is string && values[7].matches('^[\\s\\S]{1,120}$')))
        && (count <= 8 || (values[8] is string && values[8].matches('^[\\s\\S]{1,120}$')))
        && (count <= 9 || (values[9] is string && values[9].matches('^[\\s\\S]{1,120}$')));
    }
    function history(value) {
      return value is map && value.keys().hasAll(['lastTrainedDate', 'lastWorkout', 'muscles'])
        && value.keys().hasOnly(['lastTrainedDate', 'lastWorkout', 'muscles'])
        && value.lastTrainedDate is string
        && (value.lastTrainedDate == '' || value.lastTrainedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && stringWithin(value.lastWorkout, 0, 120) && muscles(value.muscles)
        && (value.lastTrainedDate != '' || (value.lastWorkout == '' && value.muscles.size() == 0));
    }
    function validPreferences(value) {
      return value.keys().hasAll(['weightUnit', 'timeZone', 'weekStartsOn', 'experience', 'goals', 'sessionsPerWeek',
          'preferredDays', 'restDays', 'sessionMinutes', 'flexibility', 'schedulingMode', 'preferredSplit',
          'equipment', 'priorityMuscles', 'excludedExercises', 'favoriteExercises', 'recoveryPreference', 'initialHistory'])
        && value.keys().hasOnly(['weightUnit', 'timeZone', 'weekStartsOn', 'experience', 'goals', 'sessionsPerWeek',
          'preferredDays', 'restDays', 'sessionMinutes', 'flexibility', 'schedulingMode', 'preferredSplit',
          'equipment', 'priorityMuscles', 'excludedExercises', 'favoriteExercises', 'recoveryPreference', 'initialHistory'])
        && value.weightUnit in ['kg', 'lb'] && stringWithin(value.timeZone, 1, 100)
        && value.weekStartsOn in [0, 1]
        && value.experience in ['beginner', 'intermediate', 'advanced']
        && value.goals.size() > 0
        && uniqueOptions(value.goals, ['Build muscle', 'Get stronger', 'General fitness', 'Endurance', 'Body recomposition'])
        && value.sessionsPerWeek is int && value.sessionsPerWeek >= 1 && value.sessionsPerWeek <= 7
        && uniqueOptions(value.preferredDays, [0, 1, 2, 3, 4, 5, 6])
        && uniqueOptions(value.restDays, [0, 1, 2, 3, 4, 5, 6])
        && !value.preferredDays.hasAny(value.restDays)
        && value.sessionMinutes is int && value.sessionMinutes >= 15 && value.sessionMinutes <= 180
        && value.flexibility in ['fixed', 'flexible']
        && value.schedulingMode in ['fixed', 'rolling', 'adaptive']
        && value.preferredSplit in ['push-pull-legs', 'upper-lower', 'full-body', 'custom']
        && value.equipment.size() > 0
        && uniqueOptions(value.equipment, ['Barbell', 'Dumbbell', 'Cable', 'Machine', 'Smith machine', 'Bodyweight', 'Resistance band', 'Kettlebell'])
        && muscles(value.priorityMuscles)
        && exerciseNames(value.excludedExercises) && exerciseNames(value.favoriteExercises)
        && !value.excludedExercises.hasAny(value.favoriteExercises)
        && value.recoveryPreference in ['balanced', 'conservative'] && history(value.initialHistory);
    }
    function validProfile(value, uid) {
      return value.keys().hasAll(['uid', 'displayName', 'onboardingCompleted', 'schemaVersion', 'createdAt', 'updatedAt'])
        && value.keys().hasOnly(['uid', 'displayName', 'onboardingCompleted', 'schemaVersion', 'createdAt', 'updatedAt'])
        && value.uid == uid && stringWithin(value.uid, 1, 128)
        && stringWithin(value.displayName, 0, 60)
        && value.onboardingCompleted is bool && (!value.onboardingCompleted || value.displayName.size() > 0)
        && value.schemaVersion == 1
        && value.createdAt is int && value.createdAt > 0
        && value.updatedAt is int && value.updatedAt >= value.createdAt;
    }

    function trainingMuscles(value) {
      return uniqueOptions(value, ['Chest', 'Front deltoids', 'Side deltoids', 'Rear deltoids', 'Upper back', 'Lats', 'Lower back', 'Trapezius', 'Biceps', 'Triceps', 'Forearms', 'Quadriceps', 'Hamstrings', 'Glutes', 'Calves', 'Abdominals', 'Obliques']);
    }
    function trainingMetadata(value, uid, id) {
      return value.keys().hasAll(['id', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId'])
        && value.id == id && stringWithin(value.id, 1, 128) && value.ownerId == uid
        && value.createdAt is int && value.createdAt > 0 && value.updatedAt is int && value.updatedAt >= value.createdAt
        && value.archived is bool && value.schemaVersion == 1
        && value.revision is int && value.revision >= 1
        && stringWithin(value.mutationId, 1, 128)
        && (value.previousMutationId == null || stringWithin(value.previousMutationId, 1, 128));
    }
    function trainingCreate(value) { return value.revision == 1 && value.previousMutationId == null; }
    function trainingUpdate(value) {
      return value.ownerId == resource.data.ownerId && value.id == resource.data.id
        && value.createdAt == resource.data.createdAt && value.updatedAt > resource.data.updatedAt
        && value.revision == resource.data.revision + 1
        && value.previousMutationId == resource.data.mutationId && value.mutationId != resource.data.mutationId;
    }
    function validCustomExercise(value) {
      return value.keys().hasOnly(['id', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'source', 'name', 'aliases', 'description', 'instructions', 'primaryMuscles', 'secondaryMuscles', 'equipment', 'movementPattern', 'category', 'difficulty', 'trackingType', 'alternativeIds', 'notes'])
        && value.source == 'custom' && stringWithin(value.name, 1, 120)
        && value.aliases is list && value.aliases.size() <= 10 && value.aliases.toSet().size() == value.aliases.size()
        && stringWithin(value.description, 0, 1000) && value.instructions is list && value.instructions.size() <= 12
        && trainingMuscles(value.primaryMuscles) && value.primaryMuscles.size() >= 1 && value.primaryMuscles.size() <= 4
        && trainingMuscles(value.secondaryMuscles) && value.secondaryMuscles.size() <= 8 && !value.primaryMuscles.hasAny(value.secondaryMuscles)
        && value.equipment in ['Barbell', 'Dumbbell', 'Cable', 'Machine', 'Smith machine', 'Bodyweight', 'Resistance band', 'Kettlebell', 'Other']
        && value.movementPattern in ['Horizontal push', 'Vertical push', 'Horizontal pull', 'Vertical pull', 'Squat', 'Hinge', 'Lunge', 'Carry', 'Rotation', 'Core stability', 'Elbow flexion', 'Elbow extension', 'Shoulder isolation', 'Calf raise', 'Locomotion', 'Other']
        && value.category in ['compound', 'isolation', 'cardio', 'mobility'] && value.difficulty in ['beginner', 'intermediate', 'advanced']
        && value.trackingType in ['weight-reps', 'reps', 'assisted-reps', 'duration', 'distance-duration']
        && value.alternativeIds is list && value.alternativeIds.size() <= 10 && stringWithin(value.notes, 0, 1000);
    }
    function routineEntry(value, entryKeys) {
      let entry = value;
      let sets = value.sets;
      let count = sets.size();
      let rest = value.restSeconds;
      let group = value.supersetGroup;
      // Deep set/snapshot validation happens in the strict runtime schemas on every
      // read and write. These rules bound every entry and nested set list while
      // remaining within Firestore's expression budget for 20 x 12-set routines.
      return entry.keys().hasOnly(entryKeys)
        && entry.id.matches('^[A-Za-z0-9_-]{1,128}$')
        && entry.exerciseId.matches('^[A-Za-z0-9_-]{1,128}$')
        && entry.exerciseSnapshot.keys().hasOnly(['name', 'trackingType', 'primaryMuscles', 'secondaryMuscles', 'equipment', 'movementPattern'])
        && sets is list && count >= 1 && count <= 12
        && rest is int && rest >= 0 && rest <= 1800
        && entry.notes.matches('^[\\s\\S]{0,1000}$') && entry.optional is bool
        && (group == null || group.matches('^[A-Za-z0-9_-]{1,128}$'));
    }
    function routineEntries(values) {
      let entryKeys = ['id', 'exerciseId', 'exerciseSnapshot', 'sets', 'restSeconds', 'notes', 'optional', 'supersetGroup'];
      let n = values.size();
      return values is list && n >= 1 && n <= 6
        && (n < 1 || routineEntry(values[0], entryKeys)) && (n < 2 || routineEntry(values[1], entryKeys))
        && (n < 3 || routineEntry(values[2], entryKeys)) && (n < 4 || routineEntry(values[3], entryKeys))
        && (n < 5 || routineEntry(values[4], entryKeys)) && (n < 6 || routineEntry(values[5], entryKeys));
    }
    function routinePage(value, pageId, expectedSize) {
      let page = getAfter(/databases/$(database)/documents/users/$(value.ownerId)/routines/$(value.id)/validationPages/$(pageId)).data;
      return page.ownerId == value.ownerId && page.routineId == value.id
        && page.mutationId == value.mutationId && page.revision == value.revision
        && page.exercises.size() == expectedSize ? page.exercises : [];
    }
    function validatedRoutineExercises(value) {
      let n = value.exercises.size();
      let first = routinePage(value, 'p0', n > 6 ? 6 : n);
      let second = n > 6 ? routinePage(value, 'p1', n > 12 ? 6 : n - 6) : [];
      let third = n > 12 ? routinePage(value, 'p2', n > 18 ? 6 : n - 12) : [];
      let fourth = n > 18 ? routinePage(value, 'p3', n - 18) : [];
      // Each page is independently validated in this same atomic batch. Matching
      // the complete ordered array to pages bound to this exact mutation keeps
      // all entry checks within Firestore's per-write expression budget.
      return value.exercises is list && n >= 1 && n <= 20
        && value.exercises == first.concat(second).concat(third).concat(fourth);
    }
    function validRoutine(value) {
      return value.keys().hasOnly(['id', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'name', 'description', 'targetMuscles', 'exercises'])
        && stringWithin(value.name, 1, 120) && stringWithin(value.description, 0, 1000)
        && trainingMuscles(value.targetMuscles) && validatedRoutineExercises(value);
    }
    function validRoutinePage(value, uid, routineId, pageId) {
      let parent = getAfter(/databases/$(database)/documents/users/$(uid)/routines/$(routineId)).data;
      return pageId in ['p0', 'p1', 'p2', 'p3']
        && value.keys().hasOnly(['ownerId', 'routineId', 'mutationId', 'revision', 'exercises'])
        && value.ownerId == uid && value.routineId == routineId
        && value.mutationId == parent.mutationId && value.revision == parent.revision
        && parent.ownerId == uid && routineEntries(value.exercises);
    }
    function validSlot(value, keys) {
      return value.keys().hasAll(keys) && value.keys().hasOnly(keys)
        && value.id.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.label.matches('^[\\s\\S]{1,80}$') && value.isRestDay is bool
        && (value.isRestDay ? value.routineId == null : value.routineId.matches('^[A-Za-z0-9_-]{1,128}$'));
    }
    function splitSlots(values, uid) {
      let keys = ['id', 'label', 'routineId', 'isRestDay'];
      let n = values.size();
      return values is list && n >= 1 && n <= 12
        && (n < 1 || validSlot(values[0], keys)) && (n < 2 || validSlot(values[1], keys))
        && (n < 3 || validSlot(values[2], keys)) && (n < 4 || validSlot(values[3], keys))
        && (n < 5 || validSlot(values[4], keys)) && (n < 6 || validSlot(values[5], keys))
        && (n < 7 || validSlot(values[6], keys)) && (n < 8 || validSlot(values[7], keys))
        && (n < 9 || validSlot(values[8], keys)) && (n < 10 || validSlot(values[9], keys))
        && (n < 11 || validSlot(values[10], keys)) && (n < 12 || validSlot(values[11], keys));
    }
    function validSplit(value, uid) {
      return value.keys().hasOnly(['id', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'name', 'description', 'mode', 'slots'])
        && stringWithin(value.name, 1, 120) && stringWithin(value.description, 0, 1000)
        && value.mode in ['fixed', 'rolling', 'adaptive'] && splitSlots(value.slots, uid);
    }
    function validTrainingSettings(value, uid) {
      return value.keys().hasOnly(['id', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'activeSplitId'])
        && value.archived == false && (value.activeSplitId == null || (stringWithin(value.activeSplitId, 1, 128)
          && getAfter(/databases/$(database)/documents/users/$(uid)/splits/$(value.activeSplitId)).data.archived == false));
    }
    function referencesRoutine(slots, id) {
      let n = slots.size();
      return (n > 0 && slots[0].routineId == id) || (n > 1 && slots[1].routineId == id)
        || (n > 2 && slots[2].routineId == id) || (n > 3 && slots[3].routineId == id)
        || (n > 4 && slots[4].routineId == id) || (n > 5 && slots[5].routineId == id)
        || (n > 6 && slots[6].routineId == id) || (n > 7 && slots[7].routineId == id)
        || (n > 8 && slots[8].routineId == id) || (n > 9 && slots[9].routineId == id)
        || (n > 10 && slots[10].routineId == id) || (n > 11 && slots[11].routineId == id);
    }
    function canArchiveRoutine(uid, id) {
      let settingsPath = /databases/$(database)/documents/users/$(uid)/trainingSettings/current;
      return !existsAfter(settingsPath) || getAfter(settingsPath).data.activeSplitId == null
        || !referencesRoutine(getAfter(/databases/$(database)/documents/users/$(uid)/splits/$(getAfter(settingsPath).data.activeSplitId)).data.slots, id);
    }

    function workoutMetadata(value, uid, id) {
      return value.id == id && value.id.matches('^[A-Za-z0-9_-]{1,128}$') && value.ownerId == uid
        && value.schemaVersion == 1 && value.revision is int && value.revision >= 1
        && value.mutationId.matches('^[A-Za-z0-9_-]{1,128}$')
        && (value.previousMutationId == null || value.previousMutationId.matches('^[A-Za-z0-9_-]{1,128}$'))
        && value.createdAt is int && value.createdAt > 0
        && value.updatedAt is int && value.updatedAt >= value.createdAt;
    }
    function workoutEntry(value, keys) {
      let entry = value;
      let sets = value.sets;
      let planned = value.plannedSets;
      let original = value.originalExerciseId;
      let rest = value.restSeconds;
      let group = value.supersetGroup;
      let snapshot = value.snapshot;
      // Every entry and both nested set-list bounds are checked here. Individual
      // planned/logged set fields, unique IDs, tracking-specific actual values,
      // and the remaining snapshot enums are checked by the strict runtime
      // schemas on every client read and write.
      // Unrolling 20 x 12 individual sets exceeds Firestore's expression budget.
      return entry.keys().hasOnly(keys)
        && entry.id.matches('^[A-Za-z0-9_-]{1,128}$')
        && entry.exerciseId.matches('^[A-Za-z0-9_-]{1,128}$')
        && snapshot.keys().hasOnly(['name', 'trackingType', 'primaryMuscles', 'secondaryMuscles', 'equipment', 'movementPattern'])
        && snapshot.keys().size() == 6
        && snapshot.name.matches('^[\\s\\S]{1,120}$')
        && snapshot.trackingType.matches('^(weight-reps|reps|assisted-reps|duration|distance-duration)$')
        && (original == null || (original.matches('^[A-Za-z0-9_-]{1,128}$') && original != entry.exerciseId))
        && planned is list && planned.size() >= 1 && planned.size() <= 12
        && sets is list && sets.size() >= 1 && sets.size() <= 12
        && rest is int && rest >= 0 && rest <= 1800
        && entry.optional is bool && entry.notes.matches('^[\\s\\S]{0,1000}$')
        && (group == null || group.matches('^[A-Za-z0-9_-]{1,128}$'));
    }
    function workoutEntries(values) {
      let keys = ['id', 'exerciseId', 'snapshot', 'originalExerciseId', 'plannedSets', 'sets', 'restSeconds', 'optional', 'supersetGroup', 'notes'];
      let n = values.size();
      return values is list && n >= 1 && n <= 5
        && (n < 1 || workoutEntry(values[0], keys)) && (n < 2 || workoutEntry(values[1], keys))
        && (n < 3 || workoutEntry(values[2], keys)) && (n < 4 || workoutEntry(values[3], keys))
        && (n < 5 || workoutEntry(values[4], keys));
    }
    function workoutPage(value, pageId, expectedSize) {
      let page = getAfter(/databases/$(database)/documents/users/$(value.ownerId)/workoutSessions/$(value.id)/validationPages/$(pageId)).data;
      return page.ownerId == value.ownerId && page.sessionId == value.id
        && page.mutationId == value.mutationId && page.revision == value.revision
        && page.exercises.size() == expectedSize ? page.exercises : [];
    }
    function validatedWorkoutExercises(value) {
      let n = value.exercises.size();
      let first = workoutPage(value, 'p0', n > 5 ? 5 : n);
      let second = n > 5 ? workoutPage(value, 'p1', n > 10 ? 5 : n - 5) : [];
      let third = n > 10 ? workoutPage(value, 'p2', n > 15 ? 5 : n - 10) : [];
      let fourth = n > 15 ? workoutPage(value, 'p3', n - 15) : [];
      return value.exercises is list && n >= 1 && n <= 20
        && value.exercises == first.concat(second).concat(third).concat(fourth);
    }
    function validWorkoutPage(value, uid, sessionId, pageId) {
      let parentPath = /databases/$(database)/documents/users/$(uid)/workoutSessions/$(sessionId);
      let parent = getAfter(parentPath).data;
      return pageId in ['p0', 'p1', 'p2', 'p3']
        && value.keys().hasOnly(['ownerId', 'sessionId', 'revision', 'mutationId', 'exercises'])
        && value.ownerId == uid && value.sessionId == sessionId
        && parent.ownerId == uid && value.mutationId == parent.mutationId && value.revision == parent.revision
        && (!exists(parentPath) || (get(parentPath).data.status == 'active' && get(parentPath).data.mutationId != parent.mutationId))
        && workoutEntries(value.exercises);
    }
    function workoutSplitContext(value) {
      return value == null || (value.keys().hasOnly(['splitId', 'splitRevision', 'slotId', 'sequence'])
        && value.splitId.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.splitRevision is int && value.splitRevision >= 1
        && value.slotId.matches('^[A-Za-z0-9_-]{1,128}$')
        && (!('sequence' in value) || (value.sequence is int && value.sequence >= 0 && value.sequence <= 9007199254740990)));
    }
    function workoutFixedContext(value) {
      return value == null || (value.keys().hasAll(['scheduleId', 'generationId', 'occurrenceId', 'occurrenceVersion'])
        && value.keys().hasOnly(['scheduleId', 'generationId', 'occurrenceId', 'occurrenceVersion'])
        && value.scheduleId.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.generationId.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.occurrenceId.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.occurrenceVersion is int && value.occurrenceVersion >= 1);
    }
    function validWorkout(value) {
      return value.keys().hasOnly(['id', 'ownerId', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'createdAt', 'updatedAt', 'status', 'startedAt', 'endedAt', 'elapsedSeconds', 'routineId', 'routineRevision', 'routineName', 'notes', 'exercises', 'splitContext', 'fixedContext', 'completionKey', 'timerEndAt', 'countsForSplit'])
        && value.status in ['active', 'completed', 'abandoned']
        && value.get('countsForSplit', false) is bool
        && (value.status == 'completed' || !value.get('countsForSplit', false))
        && value.startedAt is int && value.startedAt >= value.createdAt && value.startedAt <= value.updatedAt
        && value.elapsedSeconds is int && value.elapsedSeconds >= 0 && value.elapsedSeconds <= 31536000
        && value.routineId.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.routineRevision is int && value.routineRevision >= 1
        && value.routineName.matches('^[\\s\\S]{1,120}$') && stringWithin(value.notes, 0, 2000)
        && workoutSplitContext(value.splitContext)
        && workoutFixedContext(value.get('fixedContext', null))
        && (value.get('fixedContext', null) == null || (value.splitContext != null
          && value.fixedContext.scheduleId == value.splitContext.splitId && 'sequence' in value.splitContext))
        && (value.status == 'active'
          ? value.endedAt == null && value.completionKey == null
            && (value.timerEndAt == null || (value.timerEndAt is int && value.timerEndAt >= value.startedAt))
          : value.endedAt is int && value.endedAt >= value.startedAt && value.endedAt <= value.updatedAt
            && value.timerEndAt == null && (value.status == 'completed' ? value.completionKey == value.id : value.completionKey == null))
        && validatedWorkoutExercises(value);
    }
    function workoutHasPointer(value, uid) {
      let current = getAfter(/databases/$(database)/documents/users/$(uid)/workoutState/current).data;
      return current.ownerId == uid
        && (value.status == 'active' ? current.activeSessionId == value.id : current.activeSessionId == null)
        && (!value.get('countsForSplit', false) || countedWorkoutHasProgress(value, current));
    }
    function workoutProgress(value) {
      return value.get('rollingProgress', {});
    }
    function countedWorkoutHasProgress(value, current) {
      let context = value.splitContext;
      let progress = workoutProgress(current).get(context.splitId, {});
      return value.get('fixedContext', null) != null ? countedWorkoutHasFixedCompletion(value)
        : context != null && 'sequence' in context
        && progress.lastSessionId == value.id && progress.lastSlotId == context.slotId
        && progress.splitRevision == context.splitRevision && progress.sequence == context.sequence + 1
        && progress.completedAt == value.endedAt;
    }
    function rollingSlotIndex(slots, id) {
      let n = slots.size();
      return n > 0 && slots[0].id == id ? 0 : n > 1 && slots[1].id == id ? 1
        : n > 2 && slots[2].id == id ? 2 : n > 3 && slots[3].id == id ? 3
        : n > 4 && slots[4].id == id ? 4 : n > 5 && slots[5].id == id ? 5
        : n > 6 && slots[6].id == id ? 6 : n > 7 && slots[7].id == id ? 7
        : n > 8 && slots[8].id == id ? 8 : n > 9 && slots[9].id == id ? 9
        : n > 10 && slots[10].id == id ? 10 : n > 11 && slots[11].id == id ? 11 : -1;
    }
    function rollingNextSlot(slots, start) {
      let n = slots.size();
      return !slots[start % n].isRestDay ? slots[start % n]
        : !slots[(start + 1) % n].isRestDay ? slots[(start + 1) % n]
        : !slots[(start + 2) % n].isRestDay ? slots[(start + 2) % n]
        : !slots[(start + 3) % n].isRestDay ? slots[(start + 3) % n]
        : !slots[(start + 4) % n].isRestDay ? slots[(start + 4) % n]
        : !slots[(start + 5) % n].isRestDay ? slots[(start + 5) % n]
        : !slots[(start + 6) % n].isRestDay ? slots[(start + 6) % n]
        : !slots[(start + 7) % n].isRestDay ? slots[(start + 7) % n]
        : !slots[(start + 8) % n].isRestDay ? slots[(start + 8) % n]
        : !slots[(start + 9) % n].isRestDay ? slots[(start + 9) % n]
        : !slots[(start + 10) % n].isRestDay ? slots[(start + 10) % n]
        : !slots[(start + 11) % n].isRestDay ? slots[(start + 11) % n] : {};
    }
    function rollingExpectedSlot(split, previous, session) {
      let context = session.splitContext;
      let continuing = previous != null && previous.splitRevision == context.splitRevision;
      let index = continuing ? rollingSlotIndex(split.slots, previous.lastSlotId) : -1;
      let expected = rollingNextSlot(split.slots, index + 1);
      return (!continuing || index >= 0)
        && context.sequence == (continuing ? previous.sequence : 0)
        && (!continuing || (session.endedAt >= previous.completedAt && session.id != previous.lastSessionId))
        && expected.id == context.slotId;
    }
    function validRollingAdvance(uid, id, before, after) {
      let sessionPath = /databases/$(database)/documents/users/$(uid)/workoutSessions/$(id);
      let session = getAfter(sessionPath).data;
      let context = session.splitContext;
      let split = getAfter(/databases/$(database)/documents/users/$(uid)/splits/$(context.splitId)).data;
      let progress = after.get(context.splitId, {});
      return get(sessionPath).data.status == 'active'
        && session.status == 'completed' && session.get('countsForSplit', false)
        && session.ownerId == uid && context != null && 'sequence' in context
        && split.ownerId == uid && !split.archived && split.mode == 'rolling'
        && split.revision == context.splitRevision
        && getAfter(/databases/$(database)/documents/users/$(uid)/trainingSettings/current).data.activeSplitId == context.splitId
        && after.diff(before).affectedKeys().hasOnly([context.splitId])
        && progress.keys().hasOnly(['splitRevision', 'sequence', 'lastSlotId', 'lastSessionId', 'completedAt'])
        && progress.splitRevision is int && progress.splitRevision >= 1
        && progress.sequence is int && progress.sequence >= 1 && progress.sequence <= 9007199254740991
        && progress.completedAt is int && progress.completedAt > 0
        && countedWorkoutHasProgress(session, {'rollingProgress': after})
        && rollingExpectedSlot(split, before.get(context.splitId, null), session)
        && rollingNextSlot(split.slots, rollingSlotIndex(split.slots, context.slotId)).routineId == session.routineId;
    }
    function canChangeWorkoutProgress(value, uid) {
      let before = workoutProgress(resource.data);
      let after = workoutProgress(value);
      return before == after || (resource.data.activeSessionId != null && value.activeSessionId == null
        && validRollingAdvance(uid, resource.data.activeSessionId, before, after));
    }
    function workoutSnapshotUnchanged(value) {
      return value.startedAt == resource.data.startedAt && value.routineId == resource.data.routineId
        && value.routineRevision == resource.data.routineRevision && value.routineName == resource.data.routineName
        && value.splitContext == resource.data.splitContext
        && value.get('fixedContext', null) == resource.data.get('fixedContext', null);
    }
    function validWorkoutState(value, uid) {
      return value.keys().hasOnly(['id', 'ownerId', 'createdAt', 'updatedAt', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'activeSessionId', 'rollingProgress'])
        && workoutProgress(value) is map
        && (value.activeSessionId == null || (value.activeSessionId.matches('^[A-Za-z0-9_-]{1,128}$')
          && getAfter(/databases/$(database)/documents/users/$(uid)/workoutSessions/$(value.activeSessionId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/users/$(uid)/workoutSessions/$(value.activeSessionId)).data.ownerId == uid));
    }
    function canChangeWorkoutPointer(value, uid) {
      let previous = resource.data.activeSessionId;
      return previous == null || previous == value.activeSessionId
        || getAfter(/databases/$(database)/documents/users/$(uid)/workoutSessions/$(previous)).data.status in ['completed', 'abandoned'];
    }


    function fixedDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function fixedDateMillis(value) {
      let parts = value.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])).toMillis();
    }
    function fixedOccurrenceIndex(values, id) {
      let parts = id.split('_');
      return int(parts[parts.size() - 1]);
    }
    function fixedDateAvailable(values, date, exceptId) {
      let n = values.size();
      return (n <= 0 || values[0].id == exceptId || values[0].status == 'skipped' || values[0].scheduledDate != date)
        && (n <= 1 || values[1].id == exceptId || values[1].status == 'skipped' || values[1].scheduledDate != date)
        && (n <= 2 || values[2].id == exceptId || values[2].status == 'skipped' || values[2].scheduledDate != date)
        && (n <= 3 || values[3].id == exceptId || values[3].status == 'skipped' || values[3].scheduledDate != date)
        && (n <= 4 || values[4].id == exceptId || values[4].status == 'skipped' || values[4].scheduledDate != date);
    }
    function fixedSchedulePage(value, pageId, expectedSize) {
      let page = getAfter(/databases/$(database)/documents/users/$(value.ownerId)/fixedSchedules/$(value.id)/validationPages/$(pageId)).data;
      // The path and each page's own rules bind owner/schedule. The revision and
      // mutation force fresh, independently validated pages in this same batch.
      return page.mutationId == value.mutationId && page.revision == value.revision
        && page.occurrences.size() == expectedSize ? page.occurrences : [];
    }
    function validatedFixedOccurrences(value) {
      let n = value.occurrences.size();
      let first = fixedSchedulePage(value, 'p0', n > 5 ? 5 : n);
      let second = n > 5 ? fixedSchedulePage(value, 'p1', n > 10 ? 5 : n - 5) : [];
      let third = n > 10 ? fixedSchedulePage(value, 'p2', n > 15 ? 5 : n - 10) : [];
      let fourth = n > 15 ? fixedSchedulePage(value, 'p3', n > 20 ? 5 : n - 15) : [];
      let fifth = n > 20 ? fixedSchedulePage(value, 'p4', n > 25 ? 5 : n - 20) : [];
      let sixth = n > 25 ? fixedSchedulePage(value, 'p5', n - 25) : [];
      return value.occurrences is list && n >= 1 && n <= 28
        && value.occurrences == first.concat(second).concat(third).concat(fourth).concat(fifth).concat(sixth);
    }
    function validFixedAction(value) {
      return value.keys().hasAll(['kind', 'occurrenceId', 'otherOccurrenceId', 'sessionId'])
        && value.keys().hasOnly(['kind', 'occurrenceId', 'otherOccurrenceId', 'sessionId'])
        && ((value.kind == 'create' && value.occurrenceId == null && value.otherOccurrenceId == null && value.sessionId == null)
          || (value.kind != 'create' && value.occurrenceId.matches('^[A-Za-z0-9_-]{1,128}$')
            && ((value.kind == 'swap' && value.otherOccurrenceId.matches('^[A-Za-z0-9_-]{1,128}$') && value.otherOccurrenceId != value.occurrenceId)
              || (value.kind != 'swap' && value.otherOccurrenceId == null))
            && ((value.kind == 'complete' && value.sessionId.matches('^[A-Za-z0-9_-]{1,128}$'))
              || (value.kind != 'complete' && value.sessionId == null))))
        && value.kind in ['create', 'move', 'swap', 'skip', 'complete'];
    }
    function validFixedSchedule(value) {
      return value.keys().hasOnly(['id', 'ownerId', 'createdAt', 'updatedAt', 'archived', 'schemaVersion', 'revision', 'mutationId', 'previousMutationId', 'splitId', 'splitRevision', 'generationId', 'timeZone', 'startDate', 'endDate', 'preferredDays', 'occurrences', 'action'])
        && value.id == value.splitId && value.archived == false
        && value.splitRevision is int && value.splitRevision >= 1
        && value.generationId.matches('^[A-Za-z0-9_-]{1,128}$')
        && stringWithin(value.timeZone, 1, 100)
        && fixedDate(value.startDate) && fixedDate(value.endDate)
        && fixedDateMillis(value.endDate) - fixedDateMillis(value.startDate) == 2332800000
        && uniqueOptions(value.preferredDays, [0, 1, 2, 3, 4, 5, 6])
        && validFixedAction(value.action) && validatedFixedOccurrences(value);
    }
    function validFixedGeneration(value, uid) {
      let split = getAfter(/databases/$(database)/documents/users/$(uid)/splits/$(value.splitId)).data;
      return value.action.kind == 'create' && value.mutationId == value.generationId
        && split.ownerId == uid && !split.archived && split.mode == 'fixed' && split.revision == value.splitRevision
        && getAfter(/databases/$(database)/documents/users/$(uid)/trainingSettings/current).data.activeSplitId == value.splitId;
    }
    function fixedOccurrenceEntry(value, index, parent, split) {
      let slot = split.slots[index % split.slots.size()];
      let date = value.originalDate;
      // Exact-map comparison validates every field while staying below the
      // expression budget. Subsequent actions preserve this frozen snapshot.
      return value == {
          'id': parent.generationId + '_' + string(index), 'sequence': index,
          'slotId': slot.id, 'routineId': slot.routineId, 'label': slot.label,
          'isRestDay': slot.isRestDay, 'scheduledDate': date, 'originalDate': date,
          'version': 1, 'status': 'planned', 'completionSessionId': null, 'resolvedAt': null
        }
        && fixedDate(date) && date >= parent.startDate && date <= parent.endDate
        && (index == 0 || parent.occurrences[index - 1].originalDate < date);
    }
    function fixedOccurrencePageEntries(values, start, parent, split, creating) {
      let n = values.size();
      return values is list && n >= 1 && n <= 5
        && (!creating || ((n <= 0 || fixedOccurrenceEntry(values[0], start + 0, parent, split))
          && (n <= 1 || fixedOccurrenceEntry(values[1], start + 1, parent, split))
          && (n <= 2 || fixedOccurrenceEntry(values[2], start + 2, parent, split))
          && (n <= 3 || fixedOccurrenceEntry(values[3], start + 3, parent, split))
          && (n <= 4 || fixedOccurrenceEntry(values[4], start + 4, parent, split))));
    }
    function validFixedPage(value, uid, scheduleId, pageId) {
      let parentPath = /databases/$(database)/documents/users/$(uid)/fixedSchedules/$(scheduleId);
      let parent = getAfter(parentPath).data;
      let start = pageId == 'p0' ? 0 : pageId == 'p1' ? 5 : pageId == 'p2' ? 10 : pageId == 'p3' ? 15 : pageId == 'p4' ? 20 : 25;
      return pageId in ['p0', 'p1', 'p2', 'p3', 'p4', 'p5']
        && value.keys().hasAll(['ownerId', 'scheduleId', 'mutationId', 'revision', 'occurrences'])
        && value.keys().hasOnly(['ownerId', 'scheduleId', 'mutationId', 'revision', 'occurrences'])
        && value.ownerId == uid && value.scheduleId == scheduleId && parent.ownerId == uid
        && value.mutationId == parent.mutationId && value.revision == parent.revision
        && (!exists(parentPath) || get(parentPath).data.mutationId != parent.mutationId)
        && value.occurrences == parent.occurrences[start:start + value.occurrences.size()]
        && (parent.action.kind != 'create' || fixedOccurrencePageEntries(value.occurrences, start, parent,
          getAfter(/databases/$(database)/documents/users/$(uid)/splits/$(parent.splitId)).data, true))
        && (parent.action.kind != 'move' || fixedDateAvailable(value.occurrences,
          parent.occurrences[fixedOccurrenceIndex(parent.occurrences, parent.action.occurrenceId)].scheduledDate,
          parent.action.occurrenceId));
    }
    function fixedOccurrenceMutable(before, after, fields) {
      return before.status == 'planned' && after.version == before.version + 1 && after.version <= 9007199254740991
        && after.diff(before).affectedKeys().hasOnly(fields);
    }
    function fixedOccurrenceAction(value, before, after, uid) {
      return (value.action.kind == 'move'
          && fixedOccurrenceMutable(before, after, ['scheduledDate', 'version']) && after.scheduledDate != before.scheduledDate
          && fixedDate(after.scheduledDate) && after.scheduledDate >= value.startDate && after.scheduledDate <= value.endDate)
        || (value.action.kind == 'skip'
          && fixedOccurrenceMutable(before, after, ['status', 'resolvedAt', 'version'])
          && after.status == 'skipped' && after.resolvedAt is int && after.resolvedAt > 0)
        || (value.action.kind == 'complete'
          && fixedOccurrenceMutable(before, after, ['status', 'completionSessionId', 'resolvedAt', 'version'])
          && after.status == 'completed' && !after.isRestDay && after.completionSessionId == value.action.sessionId
          && validFixedCompletion(value, before, after, uid));
    }
    function fixedSwap(value, before, after, index, uid) {
      let otherIndex = fixedOccurrenceIndex(before, value.action.otherOccurrenceId);
      let firstBefore = before[index];
      let firstAfter = after[index];
      let secondBefore = before[otherIndex];
      let secondAfter = after[otherIndex];
      return otherIndex >= 0 && otherIndex < before.size() && otherIndex != index
        && secondBefore.id == value.action.otherOccurrenceId
        && fixedOccurrenceMutable(firstBefore, firstAfter, ['scheduledDate', 'version'])
        && fixedOccurrenceMutable(secondBefore, secondAfter, ['scheduledDate', 'version'])
        && firstAfter.scheduledDate == secondBefore.scheduledDate && secondAfter.scheduledDate == firstBefore.scheduledDate
        && after.removeAll([firstAfter, secondAfter]) == before.removeAll([firstBefore, secondBefore]);
    }
    function fixedScheduleMutation(value, uid) {
      let before = resource.data.occurrences;
      let after = value.occurrences;
      let index = fixedOccurrenceIndex(before, value.action.occurrenceId);
      return value.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'revision', 'mutationId', 'previousMutationId', 'occurrences', 'action'])
        && before.size() == after.size() && index >= 0 && index < before.size()
        && before[index].id == value.action.occurrenceId
        && ((value.action.kind == 'swap' && fixedSwap(value, before, after, index, uid))
          || (value.action.kind != 'swap' && after.removeAll([after[index]]) == before.removeAll([before[index]])
            && fixedOccurrenceAction(value, before[index], after[index], uid)));
    }
    function validFixedCompletion(schedule, before, after, uid) {
      let sessionPath = /databases/$(database)/documents/users/$(uid)/workoutSessions/$(schedule.action.sessionId);
      let session = getAfter(sessionPath).data;
      let context = session.fixedContext;
      let split = getAfter(/databases/$(database)/documents/users/$(uid)/splits/$(schedule.splitId)).data;
      return get(sessionPath).data.status == 'active' && session.status == 'completed' && session.get('countsForSplit', false)
        && session.ownerId == uid && session.completionKey == session.id
        && context.scheduleId == schedule.id && context.generationId == schedule.generationId
        && context.occurrenceId == before.id && context.occurrenceVersion == before.version
        && session.splitContext.splitId == schedule.splitId && session.splitContext.splitRevision == schedule.splitRevision
        && session.splitContext.slotId == before.slotId && session.splitContext.sequence == before.sequence
        && session.routineId == before.routineId && after.resolvedAt == session.endedAt
        && split.ownerId == uid && split.mode == 'fixed' && !split.archived && split.revision == schedule.splitRevision
        && getAfter(/databases/$(database)/documents/users/$(uid)/trainingSettings/current).data.activeSplitId == schedule.splitId;
    }
    function countedWorkoutHasFixedCompletion(session) {
      let context = session.fixedContext;
      let schedule = getAfter(/databases/$(database)/documents/users/$(session.ownerId)/fixedSchedules/$(context.scheduleId)).data;
      // The calendar's complete action independently verifies the frozen context,
      // version, timestamp, active split and atomic active -> completed transition.
      return schedule.generationId == context.generationId
        && schedule.action == {'kind': 'complete', 'sessionId': session.id,
          'occurrenceId': context.occurrenceId, 'otherOccurrenceId': null}
        && schedule.occurrences[session.splitContext.sequence].completionSessionId == session.id;
    }

    match /approvedUsers/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if approved(uid);
      allow list, delete: if false;
      allow create: if approved(uid) && validProfile(request.resource.data, uid)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/preferences/main);
      allow update: if approved(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt > resource.data.updatedAt
        && existsAfter(/databases/$(database)/documents/users/$(uid)/preferences/main);

      match /preferences/{preferenceId} {
        allow get: if approved(uid) && preferenceId == 'main';
        allow list, delete: if false;
        allow create, update: if approved(uid) && preferenceId == 'main' && validPreferences(request.resource.data)
          && existsAfter(/databases/$(database)/documents/users/$(uid));
      }
      match /customExercises/{id} {
        allow get, list: if approved(uid);
        allow create: if approved(uid) && trainingMetadata(request.resource.data, uid, id) && trainingCreate(request.resource.data) && validCustomExercise(request.resource.data);
        allow update: if approved(uid) && trainingMetadata(request.resource.data, uid, id) && trainingUpdate(request.resource.data) && validCustomExercise(request.resource.data);
        allow delete: if false;
      }
      match /routines/{id} {
        allow get, list: if approved(uid);
        allow create: if approved(uid) && trainingMetadata(request.resource.data, uid, id) && trainingCreate(request.resource.data) && validRoutine(request.resource.data);
        allow update: if approved(uid) && trainingMetadata(request.resource.data, uid, id) && trainingUpdate(request.resource.data) && validRoutine(request.resource.data)
          && (!request.resource.data.archived || canArchiveRoutine(uid, id));
        allow delete: if false;
        match /validationPages/{pageId} {
          allow read, delete: if false;
          allow create: if approved(uid) && validRoutinePage(request.resource.data, uid, id, pageId);
          allow update: if approved(uid) && request.resource.data.mutationId != resource.data.mutationId
            && validRoutinePage(request.resource.data, uid, id, pageId);
        }
      }
      match /splits/{id} {
        allow get, list: if approved(uid);
        allow create: if approved(uid) && trainingMetadata(request.resource.data, uid, id) && trainingCreate(request.resource.data) && validSplit(request.resource.data, uid);
        allow update: if approved(uid) && trainingMetadata(request.resource.data, uid, id) && trainingUpdate(request.resource.data) && validSplit(request.resource.data, uid)
          && (!request.resource.data.archived || !existsAfter(/databases/$(database)/documents/users/$(uid)/trainingSettings/current)
            || getAfter(/databases/$(database)/documents/users/$(uid)/trainingSettings/current).data.activeSplitId != id);
        allow delete: if false;
      }
      match /trainingSettings/{id} {
        allow get: if approved(uid) && id == 'current';
        allow list, delete: if false;
        allow create: if approved(uid) && id == 'current' && trainingMetadata(request.resource.data, uid, id) && trainingCreate(request.resource.data) && validTrainingSettings(request.resource.data, uid);
        allow update: if approved(uid) && id == 'current' && trainingMetadata(request.resource.data, uid, id) && trainingUpdate(request.resource.data) && validTrainingSettings(request.resource.data, uid);
      }

      match /fixedSchedules/{id} {
        allow get: if approved(uid);
        allow list: if approved(uid) && request.query.limit <= 200;
        allow create: if approved(uid) && trainingMetadata(request.resource.data, uid, id)
          && trainingCreate(request.resource.data) && validFixedSchedule(request.resource.data)
          && validFixedGeneration(request.resource.data, uid);
        allow update: if approved(uid) && trainingMetadata(request.resource.data, uid, id)
          && trainingUpdate(request.resource.data)
          && ((request.resource.data.action.kind == 'create'
            && request.resource.data.generationId != resource.data.generationId
            && validFixedSchedule(request.resource.data) && validFixedGeneration(request.resource.data, uid))
            // Each action preserves every generated field except its narrowly
            // permitted delta, so full generation-page revalidation is redundant.
            || (request.resource.data.action.kind != 'create' && validFixedAction(request.resource.data.action)
              && (request.resource.data.action.kind != 'move' || validatedFixedOccurrences(request.resource.data))
              && fixedScheduleMutation(request.resource.data, uid)));
        allow delete: if false;
        match /validationPages/{pageId} {
          allow read, delete: if false;
          allow create: if approved(uid) && validFixedPage(request.resource.data, uid, id, pageId);
          allow update: if approved(uid) && request.resource.data.mutationId != resource.data.mutationId
            && validFixedPage(request.resource.data, uid, id, pageId);
        }
      }

      match /workoutSessions/{id} {
        allow get: if approved(uid);
        allow list: if approved(uid) && request.query.limit <= 200;
        allow create: if approved(uid) && workoutMetadata(request.resource.data, uid, id)
          && trainingCreate(request.resource.data) && request.resource.data.status == 'active'
          && validWorkout(request.resource.data) && workoutHasPointer(request.resource.data, uid);
        allow update: if approved(uid) && resource.data.status == 'active'
          && workoutMetadata(request.resource.data, uid, id) && trainingUpdate(request.resource.data)
          && workoutSnapshotUnchanged(request.resource.data)
          && validWorkout(request.resource.data) && workoutHasPointer(request.resource.data, uid);
        allow delete: if false;
        match /validationPages/{pageId} {
          allow read, delete: if false;
          allow create: if approved(uid) && validWorkoutPage(request.resource.data, uid, id, pageId);
          allow update: if approved(uid) && request.resource.data.mutationId != resource.data.mutationId
            && validWorkoutPage(request.resource.data, uid, id, pageId);
        }
      }
      match /workoutState/{id} {
        allow get: if approved(uid) && id == 'current';
        allow list, delete: if false;
        allow create: if approved(uid) && id == 'current' && workoutMetadata(request.resource.data, uid, id)
          && trainingCreate(request.resource.data) && validWorkoutState(request.resource.data, uid)
          && workoutProgress(request.resource.data).size() == 0;
        allow update: if approved(uid) && id == 'current' && workoutMetadata(request.resource.data, uid, id)
          && trainingUpdate(request.resource.data) && validWorkoutState(request.resource.data, uid)
          && canChangeWorkoutPointer(request.resource.data, uid)
          && canChangeWorkoutProgress(request.resource.data, uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
